// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import {Test, console} from "forge-std/Test.sol";
import {TestLVRAuctionHook} from "../mocks/TestLVRAuctionHook.sol";
import {IPoolManager} from "@uniswap/v4-core/interfaces/IPoolManager.sol";
import {PoolId, PoolIdLibrary} from "@uniswap/v4-core/types/PoolId.sol";
import {PoolKey} from "@uniswap/v4-core/types/PoolKey.sol";
import {Currency} from "@uniswap/v4-core/types/Currency.sol";
import {IHooks} from "@uniswap/v4-core/interfaces/IHooks.sol";
import {Hooks} from "@uniswap/v4-core/libraries/Hooks.sol";
import {BalanceDelta} from "@uniswap/v4-core/types/BalanceDelta.sol";
import {BeforeSwapDelta, BeforeSwapDeltaLibrary} from "@uniswap/v4-core/types/BeforeSwapDelta.sol";
import {ModifyLiquidityParams, SwapParams} from "@uniswap/v4-core/types/PoolOperation.sol";
import {SimplePoolManager, MockAVSDirectory, MockPriceOracle} from "../mocks/SimpleMocks.sol";
import {AuctionLib} from "../../src/libraries/AuctionLib.sol";

/**
 * @title LVRAuctionHookComprehensiveTest
 * @notice Comprehensive test suite for LVRAuctionHook with 100% coverage
 */
contract LVRAuctionHookComprehensiveTest is Test {
    /*//////////////////////////////////////////////////////////////
                                CONSTANTS
    //////////////////////////////////////////////////////////////*/
    
    uint256 constant MIN_BID = 1e15;
    uint256 constant MAX_AUCTION_DURATION = 12;
    uint256 constant LP_REWARD_PERCENTAGE = 8500;
    uint256 constant AVS_REWARD_PERCENTAGE = 1000;
    uint256 constant PROTOCOL_FEE_PERCENTAGE = 300;
    uint256 constant GAS_COMPENSATION_PERCENTAGE = 200;
    uint256 constant BASIS_POINTS = 10000;
    
    /*//////////////////////////////////////////////////////////////
                                STATE
    //////////////////////////////////////////////////////////////*/
    
    TestLVRAuctionHook public hook;
    SimplePoolManager public poolManager;
    MockAVSDirectory public avsDirectory;
    MockPriceOracle public priceOracle;
    
    address public owner;
    address public feeRecipient;
    address public operator1;
    address public operator2;
    address public lp1;
    address public lp2;
    address public bidder1;
    address public bidder2;
    address public unauthorizedUser;
    
    Currency public token0;
    Currency public token1;
    Currency public stablecoin; // USDC mock
    PoolKey public key;
    PoolKey public stableKey;
    PoolId public poolId;
    PoolId public stablePoolId;
    
    /*//////////////////////////////////////////////////////////////
                                EVENTS
    //////////////////////////////////////////////////////////////*/
    
    event AuctionStarted(bytes32 indexed auctionId, PoolId indexed poolId, uint256 startTime, uint256 duration);
    event AuctionEnded(bytes32 indexed auctionId, PoolId indexed poolId, address indexed winner, uint256 winningBid);
    event MEVDistributed(PoolId indexed poolId, uint256 totalAmount, uint256 lpAmount, uint256 avsAmount, uint256 protocolAmount);
    event RewardsClaimed(PoolId indexed poolId, address indexed lp, uint256 amount);
    event OperatorAuthorized(address indexed operator, bool authorized);
    event LVRThresholdUpdated(uint256 oldThreshold, uint256 newThreshold);
    
    /*//////////////////////////////////////////////////////////////
                                SETUP
    //////////////////////////////////////////////////////////////*/
    
    function setUp() public {
        // Setup accounts
        owner = address(this);
        feeRecipient = makeAddr("feeRecipient");
        operator1 = makeAddr("operator1");
        operator2 = makeAddr("operator2");
        lp1 = makeAddr("lp1");
        lp2 = makeAddr("lp2");
        bidder1 = makeAddr("bidder1");
        bidder2 = makeAddr("bidder2");
        unauthorizedUser = makeAddr("unauthorizedUser");
        
        // Setup tokens
        token0 = Currency.wrap(makeAddr("token0"));
        token1 = Currency.wrap(makeAddr("token1"));
        stablecoin = Currency.wrap(0xA0b86a33e6441C4c27D3F50c9d6D14bDf12F4e6e); // Mock USDC
        
        // Deploy mocks
        poolManager = new SimplePoolManager();
        avsDirectory = new MockAVSDirectory();
        priceOracle = new MockPriceOracle();
        
        // Setup pool keys
        key = PoolKey({
            currency0: token0,
            currency1: token1,
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(0))
        });
        
        stableKey = PoolKey({
            currency0: token0,
            currency1: stablecoin,
            fee: 500,
            tickSpacing: 10,
            hooks: IHooks(address(0))
        });
        
        poolId = key.toId();
        stablePoolId = stableKey.toId();
        
        // Deploy hook
        hook = new TestLVRAuctionHook(
            IPoolManager(address(poolManager)),
            avsDirectory,
            priceOracle,
            feeRecipient,
            100 // 1% threshold
        );
        
        // Setup operators
        hook.setOperatorAuthorization(operator1, true);
        hook.setOperatorAuthorization(operator2, true);
        
        // Setup price oracles
        priceOracle.setPrice(token0, token1, 1e18);
        priceOracle.setPrice(token0, stablecoin, 2000e18); // $2000 per token0
        priceOracle.setPrice(token1, stablecoin, 1e18); // $1 per token1
        
        // Fund accounts
        vm.deal(address(hook), 100e18);
        vm.deal(bidder1, 50e18);
        vm.deal(bidder2, 50e18);
        vm.deal(lp1, 10e18);
        vm.deal(lp2, 10e18);
    }
    
    /*//////////////////////////////////////////////////////////////
                            HELPER FUNCTIONS
    //////////////////////////////////////////////////////////////*/
    
    function _createModifyLiquidityParams(int256 liquidityDelta) internal pure returns (ModifyLiquidityParams memory) {
        return ModifyLiquidityParams({
            tickLower: -60,
            tickUpper: 60,
            liquidityDelta: liquidityDelta,
            salt: bytes32(0)
        });
    }
    
    function _createSwapParams(bool zeroForOne, int256 amountSpecified) internal pure returns (SwapParams memory) {
        return SwapParams({
            zeroForOne: zeroForOne,
            amountSpecified: amountSpecified,
            sqrtPriceLimitX96: 0
        });
    }
    
    function _addLiquidity(address user, PoolKey memory poolKey, uint256 amount) internal {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(int256(amount));
        
        vm.startPrank(user);
        poolManager.callBeforeAddLiquidity(IHooks(address(hook)), poolKey, params, "");
        vm.stopPrank();
    }
    
    function _removeLiquidity(address user, PoolKey memory poolKey, uint256 amount) internal {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(-int256(amount));
        
        vm.startPrank(user);
        poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), poolKey, params, "");
        vm.stopPrank();
    }
    
    function _simulateSwap(PoolKey memory poolKey, SwapParams memory params) internal returns (bytes4, BeforeSwapDelta, uint24) {
        return poolManager.callBeforeSwap(IHooks(address(hook)), poolKey, params, "");
    }
    
    function _simulateAfterSwap(PoolKey memory poolKey, SwapParams memory params) internal returns (bytes4, int128) {
        BalanceDelta delta = _toBalanceDelta(100, -100);
        return poolManager.callAfterSwap(IHooks(address(hook)), poolKey, params, delta, "");
    }
    
    function _createAuction(PoolKey memory poolKey) internal returns (bytes32) {
        // Set price difference to trigger auction
        priceOracle.setPrice(poolKey.currency0, poolKey.currency1, 1.2e18); // 20% difference
        
        SwapParams memory params = _createSwapParams(true, 5e18); // Large swap
        _simulateSwap(poolKey, params);
        
        return hook.activeAuctions(poolKey.toId());
    }
    
    function _submitAuctionResult(bytes32 auctionId, address winner, uint256 winningBid) internal {
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        
        vm.startPrank(operator1);
        hook.submitAuctionResult(auctionId, winner, winningBid);
        vm.stopPrank();
    }
    
    function _toBalanceDelta(int128 amount0, int128 amount1) internal pure returns (BalanceDelta) {
        return BalanceDelta.wrap(int256(uint256(int256(amount0)) << 128 | uint256(int256(amount1))));
    }
    
    /*//////////////////////////////////////////////////////////////
                        BASIC FUNCTIONALITY TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_Deployment() public view {
        assertEq(address(hook.avsDirectory()), address(avsDirectory));
        assertEq(address(hook.priceOracle()), address(priceOracle));
        assertEq(hook.feeRecipient(), feeRecipient);
        assertEq(hook.lvrThreshold(), 100);
        assertEq(hook.owner(), owner);
        assertFalse(hook.paused());
    }
    
    function test_Constants() public view {
        assertEq(hook.MIN_BID(), MIN_BID);
        assertEq(hook.MAX_AUCTION_DURATION(), MAX_AUCTION_DURATION);
        assertEq(hook.LP_REWARD_PERCENTAGE(), LP_REWARD_PERCENTAGE);
        assertEq(hook.AVS_REWARD_PERCENTAGE(), AVS_REWARD_PERCENTAGE);
        assertEq(hook.PROTOCOL_FEE_PERCENTAGE(), PROTOCOL_FEE_PERCENTAGE);
        assertEq(hook.GAS_COMPENSATION_PERCENTAGE(), GAS_COMPENSATION_PERCENTAGE);
        assertEq(hook.BASIS_POINTS(), BASIS_POINTS);
    }
    
    function test_HookPermissions() public view {
        Hooks.Permissions memory permissions = hook.getHookPermissions();
        assertFalse(permissions.beforeInitialize);
        assertFalse(permissions.afterInitialize);
        assertTrue(permissions.beforeAddLiquidity);
        assertFalse(permissions.afterAddLiquidity);
        assertTrue(permissions.beforeRemoveLiquidity);
        assertFalse(permissions.afterRemoveLiquidity);
        assertTrue(permissions.beforeSwap);
        assertTrue(permissions.afterSwap);
        assertFalse(permissions.beforeDonate);
        assertFalse(permissions.afterDonate);
        assertFalse(permissions.beforeSwapReturnDelta);
        assertFalse(permissions.afterSwapReturnDelta);
        assertFalse(permissions.afterAddLiquidityReturnDelta);
        assertFalse(permissions.afterRemoveLiquidityReturnDelta);
    }
    
    /*//////////////////////////////////////////////////////////////
                    BEFORE ADD LIQUIDITY TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_BeforeAddLiquidity_Success() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(1000e18);
        
        BalanceDelta delta = poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 1000e18);
        assertEq(hook.totalLiquidity(poolId), 1000e18);
    }
    
    function test_BeforeAddLiquidity_ZeroLiquidity() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(0);
        
        BalanceDelta delta = poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 0);
        assertEq(hook.totalLiquidity(poolId), 0);
    }
    
    function test_BeforeAddLiquidity_NegativeLiquidity() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(-500e18);
        
        BalanceDelta delta = poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 0);
        assertEq(hook.totalLiquidity(poolId), 0);
    }
    
    function test_BeforeAddLiquidity_MultipleUsers() public {
        ModifyLiquidityParams memory params1 = _createModifyLiquidityParams(1000e18);
        ModifyLiquidityParams memory params2 = _createModifyLiquidityParams(2000e18);
        
        poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params1, "");
        poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params2, "");
        
        assertEq(hook.lpLiquidity(poolId, lp1), 1000e18);
        assertEq(hook.lpLiquidity(poolId, lp2), 2000e18);
        assertEq(hook.totalLiquidity(poolId), 3000e18);
    }
    
    function test_BeforeAddLiquidity_SameUserMultipleTimes() public {
        ModifyLiquidityParams memory params1 = _createModifyLiquidityParams(1000e18);
        ModifyLiquidityParams memory params2 = _createModifyLiquidityParams(500e18);
        
        poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params1, "");
        poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params2, "");
        
        assertEq(hook.lpLiquidity(poolId, lp1), 1500e18);
        assertEq(hook.totalLiquidity(poolId), 1500e18);
    }
    
    function test_BeforeAddLiquidity_MaxLiquidity() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(type(int128).max);
        
        BalanceDelta delta = poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), uint256(int256(type(int128).max)));
    }
    
    /*//////////////////////////////////////////////////////////////
                    BEFORE REMOVE LIQUIDITY TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_BeforeRemoveLiquidity_Success() public {
        // First add liquidity
        _addLiquidity(lp1, key, 1000e18);
        
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(-500e18);
        BalanceDelta delta = poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 500e18);
        assertEq(hook.totalLiquidity(poolId), 500e18);
    }
    
    function test_BeforeRemoveLiquidity_ZeroLiquidity() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(0);
        
        BalanceDelta delta = poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 0);
        assertEq(hook.totalLiquidity(poolId), 0);
    }
    
    function test_BeforeRemoveLiquidity_PositiveLiquidity() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(500e18);
        
        BalanceDelta delta = poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(delta, BalanceDelta.wrap(0));
        assertEq(hook.lpLiquidity(poolId, lp1), 0);
        assertEq(hook.totalLiquidity(poolId), 0);
    }
    
    function test_BeforeRemoveLiquidity_RemoveAll() public {
        _addLiquidity(lp1, key, 1000e18);
        
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(-1000e18);
        poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
        
        assertEq(hook.lpLiquidity(poolId, lp1), 0);
        assertEq(hook.totalLiquidity(poolId), 0);
    }
    
    function test_BeforeRemoveLiquidity_UnderflowProtection() public {
        // Try to remove more than exists
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(-1000e18);
        
        // This should underflow and revert
        vm.expectRevert();
        poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
    }
    
    /*//////////////////////////////////////////////////////////////
                        BEFORE SWAP TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_BeforeSwap_NoAuctionTrigger() public {
        SwapParams memory params = _createSwapParams(true, 1e18);
        
        (BeforeSwapDelta delta, uint24 fee) = _simulateSwap(key, params);
        
        assertEq(BeforeSwapDelta.unwrap(delta), 0);
        assertEq(fee, 0);
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_BeforeSwap_TriggerAuction() public {
        // Set price difference to trigger auction
        priceOracle.setPrice(token0, token1, 1.2e18); // 20% difference
        
        SwapParams memory params = _createSwapParams(true, 5e18); // Large swap
        
        (BeforeSwapDelta delta, uint24 fee) = _simulateSwap(key, params);
        
        assertEq(BeforeSwapDelta.unwrap(delta), 0);
        assertEq(fee, 0);
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_BeforeSwap_WhenPaused() public {
        hook.pause();
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        
        vm.expectRevert(abi.encodeWithSignature("EnforcedPause()"));
        _simulateSwap(key, params);
    }
    
    function test_BeforeSwap_SmallSwapNoAuction() public {
        // Set price difference but small swap
        priceOracle.setPrice(token0, token1, 1.2e18);
        
        SwapParams memory params = _createSwapParams(true, 0.5e18); // Small swap
        
        _simulateSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_BeforeSwap_ExistingAuctionNoNewAuction() public {
        bytes32 firstAuctionId = _createAuction(key);
        
        // Try to create another auction
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        // Should still have the same auction
        assertEq(hook.activeAuctions(poolId), firstAuctionId);
    }
    
    /*//////////////////////////////////////////////////////////////
                        AFTER SWAP TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_AfterSwap_NoActiveAuction() public {
        SwapParams memory params = _createSwapParams(true, 1e18);
        
        (BalanceDelta delta, uint24 fee) = _simulateAfterSwap(key, params);
        
        assertEq(BalanceDelta.unwrap(delta), 0);
        assertEq(fee, 0);
    }
    
    function test_AfterSwap_IncompleteAuction() public {
        bytes32 auctionId = _createAuction(key);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        (BalanceDelta delta, uint24 fee) = _simulateAfterSwap(key, params);
        
        assertEq(BalanceDelta.unwrap(delta), 0);
        assertEq(fee, 0);
        assertEq(hook.activeAuctions(poolId), auctionId); // Still active
    }
    
    function test_AfterSwap_CompleteAuction() public {
        bytes32 auctionId = _createAuction(key);
        _addLiquidity(lp1, key, 1000e18);
        
        _submitAuctionResult(auctionId, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0)); // Cleared
    }
    
    /*//////////////////////////////////////////////////////////////
                        AUCTION MANAGEMENT TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_StartAuction_Success() public {
        priceOracle.setPrice(token0, token1, 1.2e18);
        SwapParams memory params = _createSwapParams(true, 5e18);
        
        vm.expectEmit(true, true, false, true);
        emit AuctionStarted(bytes32(0), poolId, block.timestamp, MAX_AUCTION_DURATION);
        
        _simulateSwap(key, params);
        
        bytes32 auctionId = hook.activeAuctions(poolId);
        assertTrue(auctionId != bytes32(0));
        
        (PoolId auctionPoolId, uint256 startTime, uint256 duration, bool isActive, bool isComplete, address winner, uint256 winningBid, uint256 totalBids) = hook.auctions(auctionId);
        
        assertEq(PoolId.unwrap(auctionPoolId), PoolId.unwrap(poolId));
        assertEq(startTime, block.timestamp);
        assertEq(duration, MAX_AUCTION_DURATION);
        assertTrue(isActive);
        assertFalse(isComplete);
        assertEq(winner, address(0));
        assertEq(winningBid, 0);
        assertEq(totalBids, 0);
    }
    
    function test_SubmitAuctionResult_Success() public {
        bytes32 auctionId = _createAuction(key);
        
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        
        vm.expectEmit(true, true, true, true);
        emit AuctionEnded(auctionId, poolId, bidder1, 1.5e18);
        
        vm.startPrank(operator1);
        hook.submitAuctionResult(auctionId, bidder1, 1.5e18);
        vm.stopPrank();
        
        (, , , bool isActive, bool isComplete, address winner, uint256 winningBid,) = hook.auctions(auctionId);
        
        assertFalse(isActive);
        assertTrue(isComplete);
        assertEq(winner, bidder1);
        assertEq(winningBid, 1.5e18);
    }
    
    function test_SubmitAuctionResult_UnauthorizedOperator() public {
        bytes32 auctionId = _createAuction(key);
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        
        vm.expectRevert("LVR Auction Hook: unauthorized operator");
        hook.submitAuctionResult(auctionId, bidder1, 1e18);
    }
    
    function test_SubmitAuctionResult_AuctionNotEnded() public {
        bytes32 auctionId = _createAuction(key);
        
        vm.startPrank(operator1);
        vm.expectRevert("LVR Auction Hook: auction not ended");
        hook.submitAuctionResult(auctionId, bidder1, 1e18);
        vm.stopPrank();
    }
    
    function test_SubmitAuctionResult_InvalidAuction() public {
        bytes32 fakeAuctionId = keccak256("fake");
        
        vm.startPrank(operator1);
        vm.expectRevert("LVR Auction Hook: auction not active");
        hook.submitAuctionResult(fakeAuctionId, bidder1, 1e18);
        vm.stopPrank();
    }
    
    /*//////////////////////////////////////////////////////////////
                        MEV DISTRIBUTION TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_MEVDistribution_Success() public {
        bytes32 auctionId = _createAuction(key);
        _addLiquidity(lp1, key, 1000e18);
        
        uint256 winningBid = 10e18;
        _submitAuctionResult(auctionId, bidder1, winningBid);
        
        uint256 expectedLPAmount = (winningBid * LP_REWARD_PERCENTAGE) / BASIS_POINTS;
        uint256 expectedAVSAmount = (winningBid * AVS_REWARD_PERCENTAGE) / BASIS_POINTS;
        uint256 expectedProtocolAmount = (winningBid * PROTOCOL_FEE_PERCENTAGE) / BASIS_POINTS;
        
        vm.expectEmit(true, false, false, true);
        emit MEVDistributed(poolId, winningBid, expectedLPAmount, expectedAVSAmount, expectedProtocolAmount);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        assertEq(hook.poolRewards(poolId), expectedLPAmount * 2); // Updated twice in the function
    }
    
    function test_MEVDistribution_ZeroBid() public {
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 0);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        assertEq(hook.poolRewards(poolId), 0);
    }
    
    /*//////////////////////////////////////////////////////////////
                        REWARD CLAIMING TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_ClaimRewards_Success() public {
        _addLiquidity(lp1, key, 1000e18);
        
        // Manually add rewards for testing
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 10e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        uint256 initialBalance = lp1.balance;
        
        vm.startPrank(lp1);
        vm.expectEmit(true, true, false, true);
        emit RewardsClaimed(poolId, lp1, hook.poolRewards(poolId));
        
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        assertTrue(lp1.balance > initialBalance);
    }
    
    function test_ClaimRewards_NoLiquidity() public {
        vm.startPrank(lp1);
        vm.expectRevert("LVR Auction Hook: no liquidity provided");
        hook.claimRewards(poolId);
        vm.stopPrank();
    }
    
    function test_ClaimRewards_NoRewards() public {
        _addLiquidity(lp1, key, 1000e18);
        
        uint256 initialBalance = lp1.balance;
        
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        assertEq(lp1.balance, initialBalance);
    }
    
    function test_ClaimRewards_ProportionalDistribution() public {
        _addLiquidity(lp1, key, 1000e18);
        _addLiquidity(lp2, key, 2000e18);
        
        // Add rewards
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 9e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        uint256 lp1InitialBalance = lp1.balance;
        uint256 lp2InitialBalance = lp2.balance;
        
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        vm.startPrank(lp2);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        uint256 lp1Reward = lp1.balance - lp1InitialBalance;
        uint256 lp2Reward = lp2.balance - lp2InitialBalance;
        
        // LP2 should get 2x LP1's reward (2000/1000 = 2)
        assertApproxEqRel(lp2Reward, lp1Reward * 2, 0.01e18); // 1% tolerance
    }
    
    /*//////////////////////////////////////////////////////////////
                        ADMIN FUNCTIONS TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_SetOperatorAuthorization_Success() public {
        address newOperator = makeAddr("newOperator");
        
        vm.expectEmit(true, false, false, true);
        emit OperatorAuthorized(newOperator, true);
        
        hook.setOperatorAuthorization(newOperator, true);
        
        assertTrue(hook.authorizedOperators(newOperator));
    }
    
    function test_SetOperatorAuthorization_Revoke() public {
        vm.expectEmit(true, false, false, true);
        emit OperatorAuthorized(operator1, false);
        
        hook.setOperatorAuthorization(operator1, false);
        
        assertFalse(hook.authorizedOperators(operator1));
    }
    
    function test_SetOperatorAuthorization_OnlyOwner() public {
        vm.startPrank(unauthorizedUser);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", unauthorizedUser));
        hook.setOperatorAuthorization(operator1, false);
        vm.stopPrank();
    }
    
    function test_SetLVRThreshold_Success() public {
        uint256 newThreshold = 200;
        
        vm.expectEmit(false, false, false, true);
        emit LVRThresholdUpdated(100, newThreshold);
        
        hook.setLVRThreshold(newThreshold);
        
        assertEq(hook.lvrThreshold(), newThreshold);
    }
    
    function test_SetLVRThreshold_MaxThreshold() public {
        hook.setLVRThreshold(1000); // 10%
        assertEq(hook.lvrThreshold(), 1000);
    }
    
    function test_SetLVRThreshold_TooHigh() public {
        vm.expectRevert("LVR Auction Hook: threshold too high");
        hook.setLVRThreshold(1001);
    }
    
    function test_SetLVRThreshold_OnlyOwner() public {
        vm.startPrank(unauthorizedUser);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", unauthorizedUser));
        hook.setLVRThreshold(200);
        vm.stopPrank();
    }
    
    function test_SetFeeRecipient_Success() public {
        address newRecipient = makeAddr("newRecipient");
        
        hook.setFeeRecipient(newRecipient);
        
        assertEq(hook.feeRecipient(), newRecipient);
    }
    
    function test_SetFeeRecipient_ZeroAddress() public {
        vm.expectRevert("LVR Auction Hook: invalid address");
        hook.setFeeRecipient(address(0));
    }
    
    function test_SetFeeRecipient_OnlyOwner() public {
        vm.startPrank(unauthorizedUser);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", unauthorizedUser));
        hook.setFeeRecipient(makeAddr("newRecipient"));
        vm.stopPrank();
    }
    
    function test_Pause_Success() public {
        hook.pause();
        assertTrue(hook.paused());
    }
    
    function test_Pause_OnlyOwner() public {
        vm.startPrank(unauthorizedUser);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", unauthorizedUser));
        hook.pause();
        vm.stopPrank();
    }
    
    function test_Unpause_Success() public {
        hook.pause();
        hook.unpause();
        assertFalse(hook.paused());
    }
    
    function test_Unpause_OnlyOwner() public {
        hook.pause();
        
        vm.startPrank(unauthorizedUser);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", unauthorizedUser));
        hook.unpause();
        vm.stopPrank();
    }
    
    /*//////////////////////////////////////////////////////////////
                        PRICE CALCULATION TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_ShouldTriggerAuction_ThresholdExceeded() public {
        priceOracle.setPrice(token0, token1, 1.2e18); // 20% difference
        hook.setLVRThreshold(100); // 1%
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_ShouldTriggerAuction_ThresholdNotExceeded() public {
        priceOracle.setPrice(token0, token1, 1.005e18); // 0.5% difference
        hook.setLVRThreshold(100); // 1%
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_ShouldTriggerAuction_SmallSwap() public {
        priceOracle.setPrice(token0, token1, 1.2e18); // 20% difference
        
        SwapParams memory params = _createSwapParams(true, 0.5e18); // Small swap
        _simulateSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_ShouldTriggerAuction_NegativeSwap() public {
        priceOracle.setPrice(token0, token1, 1.2e18); // 20% difference
        
        SwapParams memory params = _createSwapParams(true, -5e18); // Negative large swap
        _simulateSwap(key, params);
        
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_ShouldTriggerAuction_ZeroPrices() public {
        priceOracle.setPrice(token0, token1, 0);
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_ShouldInvertPrice_USDCPair() public view {
        // Test with USDC as token1 (should not invert)
        assertFalse(hook.shouldInvertPrice(token0, stablecoin));
        
        // Test with USDC as token0 (should invert)
        assertTrue(hook.shouldInvertPrice(stablecoin, token1));
    }
    
    function test_ShouldInvertPrice_AddressOrdering() public view {
        // For non-stablecoin pairs, should use address ordering
        Currency tokenA = Currency.wrap(address(0x1));
        Currency tokenB = Currency.wrap(address(0x2));
        
        assertTrue(hook.shouldInvertPrice(tokenA, tokenB)); // 0x1 < 0x2
        assertFalse(hook.shouldInvertPrice(tokenB, tokenA)); // 0x2 > 0x1
    }
    
    /*//////////////////////////////////////////////////////////////
                        BOUNDARY CONDITION TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_MaxLiquidityDelta() public {
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(type(int128).max);
        
        BalanceDelta delta = poolManager.callBeforeAddLiquidity(IHooks(address(hook)), key, params, "");
        assertEq(delta, BalanceDelta.wrap(0));
    }
    
    function test_MinLiquidityDelta() public {
        _addLiquidity(lp1, key, uint256(int256(type(int128).max)));
        
        ModifyLiquidityParams memory params = _createModifyLiquidityParams(type(int128).min);
        
        BalanceDelta delta = poolManager.callBeforeRemoveLiquidity(IHooks(address(hook)), key, params, "");
        assertEq(delta, BalanceDelta.wrap(0));
    }
    
    function test_ZeroThreshold() public {
        hook.setLVRThreshold(0);
        
        // Even tiny price difference should trigger
        priceOracle.setPrice(token0, token1, 1.001e18);
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_MaxThreshold() public {
        hook.setLVRThreshold(1000); // 10%
        
        // Large price difference should still trigger
        priceOracle.setPrice(token0, token1, 1.15e18); // 15%
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_ExtremelyLargePriceDifference() public {
        priceOracle.setPrice(token0, token1, 100e18); // 10000% difference
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertTrue(hook.activeAuctions(poolId) != bytes32(0));
    }
    
    function test_VerySmallPriceDifference() public {
        priceOracle.setPrice(token0, token1, 1.000001e18); // 0.0001% difference
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        _simulateSwap(key, params);
        
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    /*//////////////////////////////////////////////////////////////
                        ERROR CONDITION TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_ReentrancyProtection_SubmitAuctionResult() public {
        bytes32 auctionId = _createAuction(key);
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        
        // This would need a malicious contract to test properly
        // For now, just verify the modifier is present
        vm.startPrank(operator1);
        hook.submitAuctionResult(auctionId, bidder1, 1e18);
        vm.stopPrank();
    }
    
    function test_ReentrancyProtection_ClaimRewards() public {
        _addLiquidity(lp1, key, 1000e18);
        
        // Similar to above, reentrancy protection is implemented
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
    }
    
    function test_OverflowProtection_PriceCalculation() public {
        // Set extremely large prices to test overflow protection
        priceOracle.setPrice(token0, token1, type(uint256).max);
        
        SwapParams memory params = _createSwapParams(true, 5e18);
        
        // Should not revert due to overflow protection
        _simulateSwap(key, params);
    }
    
    function test_MultipleAuctionsPreventedCorrectly() public {
        bytes32 firstAuctionId = _createAuction(key);
        
        // Try to create multiple auctions
        for (uint i = 0; i < 5; i++) {
            SwapParams memory params = _createSwapParams(true, 5e18);
            _simulateSwap(key, params);
            
            // Should still be the same auction
            assertEq(hook.activeAuctions(poolId), firstAuctionId);
        }
    }
    
    function test_AuctionCleanupAfterProcessing() public {
        bytes32 auctionId = _createAuction(key);
        _addLiquidity(lp1, key, 1000e18);
        
        _submitAuctionResult(auctionId, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Auction should be cleared
        assertEq(hook.activeAuctions(poolId), bytes32(0));
        
        // Should be able to create new auction
        bytes32 newAuctionId = _createAuction(key);
        assertTrue(newAuctionId != bytes32(0));
        assertTrue(newAuctionId != auctionId);
    }
    
    /*//////////////////////////////////////////////////////////////
                        INTEGRATION TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_FullAuctionLifecycle_SingleLP() public {
        // Setup
        _addLiquidity(lp1, key, 1000e18);
        uint256 initialBalance = lp1.balance;
        
        // Create auction
        bytes32 auctionId = _createAuction(key);
        assertTrue(auctionId != bytes32(0));
        
        // Submit result
        uint256 winningBid = 5e18;
        _submitAuctionResult(auctionId, bidder1, winningBid);
        
        // Process through afterSwap
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Claim rewards
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        // Verify LP received rewards
        assertTrue(lp1.balance > initialBalance);
        
        // Verify auction is cleared
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_FullAuctionLifecycle_MultipleLPs() public {
        // Setup multiple LPs
        _addLiquidity(lp1, key, 1000e18);
        _addLiquidity(lp2, key, 2000e18);
        
        uint256 lp1InitialBalance = lp1.balance;
        uint256 lp2InitialBalance = lp2.balance;
        
        // Create and process auction
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 9e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Both LPs claim rewards
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        vm.startPrank(lp2);
        hook.claimRewards(poolId);
        vm.stopPrank();
        
        // Verify proportional rewards
        uint256 lp1Reward = lp1.balance - lp1InitialBalance;
        uint256 lp2Reward = lp2.balance - lp2InitialBalance;
        
        // LP2 should get 2x LP1's reward
        assertApproxEqRel(lp2Reward, lp1Reward * 2, 0.01e18);
    }
    
    function test_SequentialAuctions() public {
        _addLiquidity(lp1, key, 1000e18);
        
        // First auction
        bytes32 auction1 = _createAuction(key);
        _submitAuctionResult(auction1, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Second auction
        bytes32 auction2 = _createAuction(key);
        assertTrue(auction2 != auction1);
        
        _submitAuctionResult(auction2, bidder2, 3e18);
        _simulateAfterSwap(key, params);
        
        // Verify rewards accumulated
        assertTrue(hook.poolRewards(poolId) > 0);
    }
    
    /*//////////////////////////////////////////////////////////////
                        EDGE CASE TESTS
    //////////////////////////////////////////////////////////////*/
    
    function test_AuctionWithZeroLiquidity() public {
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Should process without error even with no LPs
        assertEq(hook.activeAuctions(poolId), bytes32(0));
    }
    
    function test_ClaimRewardsAfterRemovingAllLiquidity() public {
        _addLiquidity(lp1, key, 1000e18);
        
        // Add rewards
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Remove all liquidity
        _removeLiquidity(lp1, key, 1000e18);
        
        // Should not be able to claim rewards
        vm.startPrank(lp1);
        vm.expectRevert("LVR Auction Hook: no liquidity provided");
        hook.claimRewards(poolId);
        vm.stopPrank();
    }
    
    function test_LiquidityAddedAfterRewards() public {
        // Add rewards first
        bytes32 auctionId = _createAuction(key);
        _submitAuctionResult(auctionId, bidder1, 2e18);
        
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
        
        // Then add liquidity
        _addLiquidity(lp1, key, 1000e18);
        
        // Should be able to claim proportional rewards
        vm.startPrank(lp1);
        hook.claimRewards(poolId);
        vm.stopPrank();
    }
    
    function test_MultipleOperatorsSubmitDifferentResults() public {
        bytes32 auctionId = _createAuction(key);
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        
        // First operator submits result
        vm.startPrank(operator1);
        hook.submitAuctionResult(auctionId, bidder1, 2e18);
        vm.stopPrank();
        
        // Second operator tries to submit different result
        vm.startPrank(operator2);
        vm.expectRevert("LVR Auction Hook: auction not active");
        hook.submitAuctionResult(auctionId, bidder2, 3e18);
        vm.stopPrank();
    }
    
    function test_PausedDuringAuction() public {
        bytes32 auctionId = _createAuction(key);
        
        // Pause the contract
        hook.pause();
        
        // Try to submit result (should work as it doesn't have whenNotPaused modifier)
        vm.warp(block.timestamp + MAX_AUCTION_DURATION + 1);
        vm.startPrank(operator1);
        hook.submitAuctionResult(auctionId, bidder1, 2e18);
        vm.stopPrank();
        
        // Unpause and process
        hook.unpause();
        SwapParams memory params = _createSwapParams(true, 1e18);
        _simulateAfterSwap(key, params);
    }
    
    receive() external payable {}
}